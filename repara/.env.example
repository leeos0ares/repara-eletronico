# Copie este arquivo para .env.local e preencha os valores.
# Nunca envie o .env.local para o GitHub.

# String de conexão do MongoDB Atlas (coloque o nome do banco no final, ex.: /repara)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/repara

# Chave secreta do NextAuth (gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET=

# URL do site. Local: http://localhost:3000 | Vercel: a URL do deploy
NEXTAUTH_URL=http://localhost:3000
